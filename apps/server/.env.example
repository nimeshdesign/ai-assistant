# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (web app + Electron dev server)
CLIENT_ORIGINS=http://localhost:5173

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/ai_interview_assistant
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/ai_interview_assistant
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_assistant

# ---- Auth (Phase 3) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Refresh tokens are random opaque values stored hashed in auth_sessions (no secret needed).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Refresh-token cookie. COOKIE_SECURE defaults to true when NODE_ENV=production.
# Use COOKIE_SAMESITE=none (with HTTPS) only if the web app and API are on different sites.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ---- AI (Phase 5) — kept on the server only, never sent to the client ----
OPENAI_API_KEY=
# Model names are configurable; use any chat model your key can access.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_QUALITY=gpt-4o
# Speech-to-text and natural read-aloud voices
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional: an OpenAI-compatible endpoint (e.g. a proxy or Azure-compatible gateway)
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=30000
# Per-user AI requests per 5 minutes
AI_RATE_LIMIT_PER_5MIN=30

# ---- Logging ----
LOG_LEVEL=info
