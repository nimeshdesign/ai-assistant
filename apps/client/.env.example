# Base URL of the REST API. Leave as /api/v1 in development (Vite proxies to the server).
# For a production build served separately, set the full URL, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:5000
